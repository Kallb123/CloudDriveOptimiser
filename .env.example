# ─────────────────────────────────────────────────────────────
#  CloudDriveOptimiser — Environment variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Google OAuth 2.0 credentials ──────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── URLs (optional) ───────────────────────────────────────────
# Leave these blank: the OAuth callback and post-login redirect are derived from
# the URL in the browser (e.g. https://drive.example.com/auth/google/callback).
# Register <your-origin>/auth/google/callback in Google Cloud Console.
#
# Override the OAuth callback URL, e.g. https://drive.example.com/auth/google/callback
OAUTH_REDIRECT_URI=
# Only needed if the frontend is served from a different origin than the backend
# (used for CORS and post-login redirects)
FRONTEND_URL=

# ── Session ───────────────────────────────────────────────────
# Random string used to sign session cookies — change this!
SESSION_SECRET=replace-with-a-long-random-secret

# ── Port (Docker Compose) ─────────────────────────────────────
# Host port that the frontend nginx container will be bound to
FRONTEND_PORT=80

# ── Drive analysis ────────────────────────────────────────────
# Maximum number of files to retrieve per analysis
MAX_FILES=200

# ── Video transcoding ─────────────────────────────────────────
# Target vertical resolution for optimised videos (e.g. 720 = 720p)
TRANSCODE_HEIGHT=720
# FFmpeg CRF quality value (lower = better quality, larger file; 18–28 is typical)
TRANSCODE_CRF=28
# FFmpeg encoding preset (ultrafast / superfast / veryfast / faster / fast / medium / slow / slower / veryslow)
TRANSCODE_PRESET=medium
# Number of videos downloaded/transcoded at the same time; the rest wait in the queue (raise with care: ffmpeg is CPU-heavy)
MAX_CONCURRENT_JOBS=1
# Minimum size reduction (percent) before an original is replaced; smaller savings are skipped
MIN_SAVING_PERCENT=10

# ── Duplicati backup check (optional) ─────────────────────────
# When set, each optimisable video is looked up in Duplicati by file name and
# size, so you can see whether the original is backed up before replacing it.
# Missing backups are a warning only; they never block optimisation.
# Base URL of the Duplicati web UI, reachable from the backend container
DUPLICATI_URL=
# Either a long-lived token (start Duplicati with --webservice-enable-forever-token,
# then run: duplicati-server-util issue-forever-token --hosturl <url> --password <pw>)…
DUPLICATI_TOKEN=
# …or the Duplicati web UI password
DUPLICATI_PASSWORD=
# Comma-separated backup IDs to search (blank = all backups)
DUPLICATI_BACKUP_IDS=
